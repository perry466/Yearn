# =============================================
# Yearn · 岁岁念  环境变量配置
# 复制本文件为 .env，然后填入真实值
# .env 已在 .gitignore 中，不会被提交到 GitHub
# =============================================

# ---- 服务器配置（可选，默认 0.0.0.0:8000）----
# YERN_HOST=0.0.0.0
# YERN_PORT=8000

# ---- 邮件提醒配置 ----
# 是否启用邮件提醒（true / false）
EMAIL_ENABLED=false

# SMTP 服务器
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# 你的邮箱地址
EMAIL_USER=your_email@example.com

# 应用专用密码（非登录密码）
# 163邮箱: https://mail.163.com > 设置 > POP3/SMTP/IMAP > 开启并获取授权码
# QQ邮箱: https://mail.qq.com > 设置 > 账户 > POP3/SMTP/IMAP > 开启并获取授权码
# Gmail:   https://myaccount.google.com > 安全性 > 应用密码
EMAIL_PASSWORD=your_app_password

# 发件人显示名称
EMAIL_FROM_NAME=🎂 生日提醒

# 接收提醒的邮箱（可与发件人相同）
EMAIL_TO=notify@example.com

# ---- Server酱配置 ----
# 是否启用 Server酱（true / false）
SERVERCHAN_ENABLED=false

# 前往 https://sc.ftqq.com/3.version 注册并获取 SCKEY
SERVERCHAN_SCKEY=your_sckey_here
